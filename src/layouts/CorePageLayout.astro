---
import BaseLayout from './BaseLayout.astro';
import AssetImage from '../components/AssetImage.astro';
import PublicRelationshipMap from '../components/PublicRelationshipMap.astro';
import { pillars } from '../data/site';
const { page, canonical, searchTitle, metaDescription, heroAsset, heroAlt, pillarOverview, relationshipMap } = Astro.props;
---
<BaseLayout title={searchTitle} description={metaDescription} canonical={canonical}>
  <article class:list={['core-page', heroAsset && 'core-page--with-hero']}>
    <header class:list={['page-hero', 'shell', heroAsset && 'core-page__hero']}>
      <div class="core-page__hero-copy">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p class="lede">{page.intro}</p>
      </div>
      {heroAsset && <div class="core-page__hero-media">
        <AssetImage asset={heroAsset} alt={heroAlt} className="core-page__hero-image" loading="eager" />
      </div>}
    </header>
    {relationshipMap && <PublicRelationshipMap />}
    <div class="shell core-page__body">
      {page.sections.map(([heading, copy]) => (
        <section class="core-page__section">
          <h2>{heading}</h2>
          {copy.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
      {pillarOverview && <section class="core-page__section core-page__pillar-overview">
        <h2>The 12 Pillars</h2>
        <p>A connected set of areas for exploring how principles meet the practical questions of civilisation.</p>
        <ul>
          {pillars.map(([, name]) => <li>{name}</li>)}
        </ul>
      </section>}
      <nav class="page-actions core-page__actions" aria-label="Continue exploring">
        {page.links.map(([label, href]) => <a class="button" href={href}>{label}</a>)}
      </nav>
    </div>
  </article>
</BaseLayout>
<style>
  .core-page--with-hero .core-page__hero {
    display: grid;
    width: min(1120px, calc(100% - 2rem));
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    grid-template-columns: minmax(0, .48fr) minmax(0, .52fr);
    gap: clamp(3rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(4rem, 8vw, 6rem) clamp(3rem, 6vw, 4.5rem);
  }

  .core-page--with-hero .core-page__hero-copy {
    min-width: 0;
    max-width: 100%;
  }
  .core-page--with-hero h1 {
    max-width: 14ch;
    font-size: clamp(3rem, 4vw, 4.5rem);
    line-height: 1.08;
  }
  .core-page--with-hero .core-page__hero-copy .lede {
    max-width: 38rem;
    font-size: clamp(1.05rem, 1.2vw, 1.125rem);
    line-height: 1.7;
  }
  .core-page--with-hero .core-page__hero-media {
    width: 100%;
    max-width: 540px;
    min-width: 0;
    box-sizing: border-box;
    justify-self: end;
  }
  .core-page--with-hero .core-page__hero-image {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .core-page--with-hero .core-page__body {
    max-width: 760px;
    padding-bottom: 6rem;
  }
  .core-page--with-hero .core-page__section { padding-block: clamp(3.5rem, 6vw, 4.5rem); }
  .core-page--with-hero .core-page__section p {
    max-width: 68ch;
    font-size: 1.1rem;
    line-height: 1.78;
  }
  .core-page--with-hero .core-page__section h2 {
    max-width: 18ch;
    font-size: clamp(2rem, 2.6vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  @media (max-width: 760px) {
    .core-page--with-hero .core-page__hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 4rem 3rem;
    }
    .core-page--with-hero .core-page__hero-media { max-width: 620px; }
    .core-page--with-hero .core-page__hero-image { aspect-ratio: 4 / 3; }
    .core-page--with-hero .core-page__section { padding-block: 2.5rem; }
  }
</style>
