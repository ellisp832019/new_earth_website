---
import '../styles/global.css';
import AssetImage from '../components/AssetImage.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { assets, nav } from '../data/site';
const { title, description='A living framework for conscious civilisation.', canonical='/' } = Astro.props;
const localPreview=process.env.PUBLIC_ASSET_MODE !== 'PUBLIC';
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content={description}><link rel="canonical" href={`https://new-earth.uk${canonical}`}><title>{title} | New Earth</title></head><body class={localPreview?'local-preview':'public-mode'}><a class="skip-link" href="#main">Skip to main content</a><header class="site-header"><div class="shell header-inner"><a class="site-brand" href="/" aria-label="New Earth home"><AssetImage asset={assets.emblem} alt="" className="site-brand__emblem" loading="eager" /><span class="site-brand__text"><strong>NEW EARTH</strong><span>CONSCIOUS CIVILISATION</span></span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">Menu</button><nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation">{nav.map(([label,href])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav></div></header>{localPreview&&<p class="dev-indicator" aria-label="Development mode">LOCAL PREVIEW</p>}<main id="main"><slot /></main><footer class="site-footer"><div class="shell footer-grid"><div><a class="site-brand footer-brand" href="/" aria-label="New Earth home"><AssetImage asset={assets.emblem} alt="" className="site-brand__emblem" /><span class="site-brand__text"><strong>NEW EARTH</strong><span>CONSCIOUS CIVILISATION</span></span></a><p>A living framework for conscious civilisation.</p></div><div><h2>Explore</h2><a href="/vision/">Vision</a><a href="/blueprint/">Blueprint</a><a href="/ecosystem/">Ecosystem</a></div><div><h2>Participate</h2><a href="/get-involved/">Get Involved</a><a href="/contact/">Contact</a></div><div><h2>Learn</h2><a href="/journal/">Journal</a><a href="/resources/">Resources</a></div><div><h2>Legal</h2><a href="/legal/">Legal information</a><a href="/legal/privacy-policy/">Privacy Policy</a><a href="/legal/cookie-policy/">Cookie Policy</a><a href="/legal/terms/">Terms of Use</a><a href="/legal/disclaimer/">Disclaimer</a></div><div><h2>Trust</h2><a href="/about/">About New Earth</a><a href="/ecosystem/command-centre/">Command Centre information</a></div></div></footer><ImageLightbox /><script is:inline>const b=document.querySelector('.menu-toggle'),n=document.querySelector('.primary-nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('is-open',!o)});</script></body></html>
