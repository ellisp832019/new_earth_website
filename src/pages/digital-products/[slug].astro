---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicStatusBadge from '../../components/PublicStatusBadge.astro';
import { publicProducts, type ProductRecord } from '../../data/products';
import { getProductReadiness, productCtaState } from '../../data/product-readiness';

export function getStaticPaths() {
  const localPreview = process.env.PUBLIC_ASSET_MODE !== 'PUBLIC';
  return publicProducts
    .filter((product) => product.publicEnabled && (localPreview || !product.previewOnly))
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: ProductRecord;
}

const { product } = Astro.props;
const readiness = getProductReadiness(product.readinessId);
const cta = productCtaState(product, readiness);
const isAiMadeSimple = product.id === 'NE-DP-001';
---

<BaseLayout title={isAiMadeSimple ? 'AI Made Simple | Beginner AI Guide and Starter Pack | New Earth' : `${product.title} | Digital Products`} description={isAiMadeSimple ? 'Learn useful AI basics, write clearer prompts and check answers. AI Made Simple includes a beginner guide, 50 prompts, worksheets and a seven-day challenge.' : product.summary} canonical={`/digital-products/${product.slug}/`} socialImagePath={isAiMadeSimple ? product.socialAsset : undefined} socialImageAlt={isAiMadeSimple ? 'AI Made Simple cover for a beginner AI learning pack.' : undefined}>
  {isAiMadeSimple ? (
    <article class="product-page product-page--ai-made-simple">
      <header class="product-hero shell">
        <div class="product-hero__copy">
          <p class="eyebrow">New Earth Practical Guides</p>
          <PublicStatusBadge status={product.publicStatus} />
          <h1>{product.title}</h1>
          <p class="lede">{product.summary}</p>
          <p class="product-hero__price">Planned launch price — £9.99</p>
          <div class="page-actions" aria-label="AI Made Simple preview resources">
            <a class="button" href="/local-assets/digital-products/ai-made-simple/NE-DP-001_FREE_10_Things_You_Can_Ask_AI_v1.1.pdf" target="_blank" rel="noreferrer">Read the free guide</a>
            <a class="button button--outline" href="/local-assets/digital-products/ai-made-simple/AI_Made_Simple_Sample.pdf" target="_blank" rel="noreferrer">View the sample</a>
          </div>
        </div>
        {product.coverAsset && <img class="product-hero__cover" src={product.coverAsset} alt="AI Made Simple cover: a practical beginner's guide to using artificial intelligence in everyday life." fetchpriority="high" />}
      </header>

      <section class="product-section product-section--why shell" aria-labelledby="why-it-exists-title">
        <p class="eyebrow">Why it exists</p>
        <h2 id="why-it-exists-title">A grounded first step into AI.</h2>
        <div class="prose-grid">
          <p>AI can feel technical or intimidating. AI Made Simple is for complete beginners who want to use it for ordinary tasks such as organising notes, exploring ideas, learning and drafting messages.</p>
          <p>It focuses on capability rather than dependence. Human judgement remains essential: AI can produce confident errors, and important information needs checking.</p>
        </div>
      </section>

      <section class="product-section product-section--tint" aria-labelledby="skills-title">
        <div class="shell"><p class="eyebrow">Three practical skills</p><h2 id="skills-title">Use AI with more clarity and care.</h2><div class="skills-grid"><article><h3>CLEAR</h3><p>Ask clearly by explaining the task and the kind of answer you need.</p></article><article><h3>CHECK</h3><p>Check what matters before acting on important claims.</p></article><article><h3>PRACTICE</h3><p>Use everyday prompts and exercises to build confidence over time.</p></article></div></div>
      </section>

      <section class="product-section product-section--included shell" aria-labelledby="included-title">
        <p class="eyebrow">What is included</p>
        <h2 id="included-title">A practical digital starter pack.</h2>
        <ul class="included-list"><li><strong>AI Made Simple</strong><span>55 pages</span></li><li><strong>50 Beginner AI Prompts</strong><span>16 pages</span></li><li><strong>CLEAR + CHECK Worksheets</strong><span>10 pages</span></li><li><strong>7-Day AI Challenge</strong><span>11 pages</span></li><li><strong>AI Quick Reference Card</strong><span>2 pages</span></li><li><strong>Start Here instructions</strong><span>Included with delivery</span></li></ul>
        <p class="section-note">The paid resources are not available to download from this preview.</p>
      </section>

      <section class="product-section product-section--sample" aria-labelledby="sample-title">
        <div class="shell sample-grid"><div><p class="eyebrow">Try before you buy</p><h2 id="sample-title">Start with useful examples.</h2><div class="sample-actions"><article><h3>10 Things You Can Ask AI</h3><p>An 8-page free guide with simple ideas for your first conversations.</p><a class="text-link" href="/local-assets/digital-products/ai-made-simple/NE-DP-001_FREE_10_Things_You_Can_Ask_AI_v1.1.pdf" target="_blank" rel="noreferrer">Read the free guide <span aria-hidden="true">→</span></a></article><article><h3>AI Made Simple Sample</h3><p>A genuine 3-page extract from the main guide.</p><a class="text-link" href="/local-assets/digital-products/ai-made-simple/AI_Made_Simple_Sample.pdf" target="_blank" rel="noreferrer">View the sample <span aria-hidden="true">→</span></a></article></div></div><img src="/local-assets/digital-products/ai-made-simple/ai-made-simple-clear-sample.png" alt="Sample page showing the CLEAR prompt method: Context, Level, Exact task, Audience and Result." loading="lazy" /></div>
      </section>

      <section class="product-section product-section--creator shell" aria-labelledby="creator-title"><p class="eyebrow">Creator</p><h2 id="creator-title">Peter Ellis</h2><p class="creator-series">New Earth Practical Guides</p><p class="lede">Practical knowledge designed to help people build capability, make informed choices and stay involved in the decisions that affect them.</p></section>

      <section class="product-section product-section--tint" aria-labelledby="details-title"><div class="shell"><p class="eyebrow">Product details</p><h2 id="details-title">Prepared with clear boundaries.</h2><dl class="details-grid"><div><dt>Format</dt><dd>Digital PDF learning pack</dd></div><div><dt>Language</dt><dd>English</dd></div><div><dt>Edition</dt><dd>1.1</dd></div><div><dt>Status</dt><dd>Coming Soon</dd></div><div><dt>Delivery</dt><dd>Not active yet</dd></div><div><dt>Accessibility</dt><dd>PDFs contain selectable teaching text. Worksheets are printable rather than interactive forms. Formal PDF/UA conformance and assistive-technology testing have not yet been completed.</dd></div></dl></div></section>

      <section class="product-section product-section--faq shell" aria-labelledby="faq-title"><p class="eyebrow">FAQ</p><h2 id="faq-title">Questions before release.</h2><div class="faq-list"><details><summary>Who is it for?</summary><p>Complete beginners who want a practical way to start using AI.</p></details><details><summary>Do I need coding skills?</summary><p>No.</p></details><details><summary>Is this software or an AI account?</summary><p>No. It is a downloadable PDF learning pack. AI access is separate.</p></details><details><summary>Can I print the resources?</summary><p>Yes, for personal use subject to final licence confirmation.</p></details><details><summary>Are the worksheets interactive?</summary><p>No. They are printable rather than fillable forms.</p></details><details><summary>Will AI always give the right answer?</summary><p>No. Learning to check important claims is central to the guide.</p></details></div></section>

      <section class="product-section product-section--closing"><div class="shell"><p class="eyebrow">Related learning</p><h2>Keep building useful understanding.</h2><p>Explore free public learning and practical context across New Earth.</p><a class="button button--outline" href="/learn/">Explore practical learning</a></div></section>
    </article>
  ) : (
  <article class="shell product-page">
    <header>
      <p class="eyebrow">Digital Products · {product.creator}</p>
      <PublicStatusBadge status={product.publicStatus} />
      <h1>{product.title}</h1>
      <p class="lede">{product.summary}</p>
    </header>
    <section aria-labelledby="product-details-title">
      <h2 id="product-details-title">Product details</h2>
      <p>{product.description}</p>
      <dl><div><dt>Format</dt><dd>{product.format}</dd></div><div><dt>Version</dt><dd>{product.version}</dd></div><div><dt>Creator</dt><dd>{product.creator}</dd></div><div><dt>Availability</dt><dd>{product.availabilityNote}</dd></div><div><dt>Delivery</dt><dd>{product.deliveryNote}</dd></div><div><dt>Support</dt><dd>{product.supportNote}</dd></div><div><dt>Rights and attribution</dt><dd>{product.rightsNote}</dd></div>{product.priceDisplay ? <div><dt>Price</dt><dd>{product.priceDisplay}{product.currency ? ` (${product.currency})` : ''}</dd></div> : null}</dl>
      {product.bundleEligible ? <p>This product may be included in an approved future bundle.</p> : null}
      {cta.href ? <a class="button" href={cta.href}>{cta.label}</a> : <p class="availability-note">{cta.label}</p>}
    </section>
  </article>
  )}
</BaseLayout>

<style>
  .product-page { max-width: 820px; padding-block: clamp(4rem, 9vw, 7rem); }
  header { display: grid; justify-items: start; gap: 1rem; padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  header h1, header p { margin: 0; }
  section { border-top: 1px solid var(--line); padding-top: clamp(2.75rem, 6vw, 4.75rem); }
  dl { display: grid; gap: 1rem; margin-block: 2rem; }
  dl div { border-left: 2px solid var(--line); padding-left: 1rem; }
  dt { color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  dd { margin: .25rem 0 0; }
  .availability-note { color: var(--muted); font-weight: 700; }
  .product-page--ai-made-simple { width: 100%; max-width: none; padding-block: clamp(3.5rem, 8vw, 7rem); }
  .product-page--ai-made-simple > .shell, .product-page--ai-made-simple > .product-section { width: min(1100px, calc(100% - 2rem)); margin-inline: auto; }
  .product-page--ai-made-simple > .product-section > .shell { width: 100%; margin-inline: 0; }
  .product-hero { display: grid; min-width: 0; justify-items: center; gap: clamp(2.5rem, 6vw, 4.5rem); text-align: center; }
  .product-hero__copy { display: grid; min-width: 0; justify-items: center; gap: 1rem; }
  .product-hero__copy h1, .product-hero__copy p { margin: 0; }
  .product-hero__cover { display: block; width: 100%; max-width: 28rem; min-width: 0; justify-self: center; border-radius: var(--radius); box-shadow: var(--shadow); }
  .product-hero .page-actions { justify-content: center; }
  .product-hero__price { color: var(--forest); font-weight: 800; }
  .button--outline { border: 1px solid var(--forest); background: transparent; color: var(--forest); }
  .product-section { padding-block: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--line); }
  .product-section--tint, .product-section--closing { border-radius: var(--radius); }
  .product-section--tint { background: var(--sage); }
  .product-section--tint .shell, .product-section--sample .shell { max-width: 1200px; }
  .product-section--why { text-align: center; }
  .prose-grid, .sample-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 5vw, 5rem); }
  .prose-grid { max-width: 900px; margin-inline: auto; text-align: left; }
  .skills-grid, .sample-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .skills-grid article, .sample-actions article { padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--ivory); }
  .product-section--included { max-width: 820px; }
  .included-list { max-width: 720px; margin: 2rem auto 1rem; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .included-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .included-list span, .section-note, .creator-series { color: var(--muted); }
  .sample-grid { align-items: center; }
  .sample-grid > img { width: min(100%, 31rem); justify-self: end; border-radius: var(--radius); box-shadow: var(--shadow); }
  .sample-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .details-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0 0; }
  .details-grid div { padding: 1rem; border-left: 3px solid var(--teal); background: var(--ivory); }
  .details-grid dt { color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .details-grid dd { margin: .35rem 0 0; }
  .product-section--creator, .product-section--faq { max-width: 850px; }
  .faq-list { max-width: 850px; margin-top: 2rem; border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .faq-list summary { cursor: pointer; color: var(--deep); font-family: var(--serif); font-size: 1.15rem; font-weight: 700; }
  .faq-list p { margin-bottom: 0; }
  .product-section--closing { background: var(--deep); color: #fff; }
  .product-section--closing h2, .product-section--closing .eyebrow { color: #fff; }
  .product-section--closing .button--outline { border-color: #fff; color: #fff; }
  @media (max-width: 760px) { .product-hero, .prose-grid, .sample-grid, .details-grid { grid-template-columns: minmax(0, 1fr); } .product-hero__cover { max-width: 100%; justify-self: center; } .sample-grid > img { max-width: 100%; justify-self: start; } .skills-grid, .sample-actions { grid-template-columns: 1fr; } .included-list li { align-items: flex-start; flex-direction: column; gap: .15rem; } }
</style>
