---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pages } from '../../data/site';

const page = pages.about;
const [purpose, localFirst, exploring, technology, held, starting] = page.sections;
const localFirstParagraphs = localFirst[1].split('\n\n');
const heldParagraphs = held[1].split('\n\n');
---
<BaseLayout
  title="About New Earth | Purpose, Principles and Stewardship"
  description="Learn why New Earth exists, what it is exploring and how its ideas, frameworks and developing work are being stewarded."
  canonical="/about/"
>
  <article class="about-page">
    <header class="page-hero shell about-page__hero">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p class="lede">{page.intro}</p>
    </header>

    <div class="shell about-page__body">
      <section class="about-page__section">
        <h2>{purpose[0]}</h2>
        <p>{purpose[1]}</p>
      </section>

      <section class="about-page__local-first" aria-labelledby="about-local-first-title">
        <p class="eyebrow">Local first</p>
        <h2 id="about-local-first-title">{localFirst[0]}</h2>
        <p class="about-page__lead">New Earth starts where we are.</p>
        {localFirstParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <ol class="about-page__path" aria-label="Local-first pathway">
          <li><strong>Person</strong><span>wellbeing, awareness, agency</span></li>
          <li><strong>Home / Place</strong><span>food, resources, environment</span></li>
          <li><strong>Community</strong><span>knowledge, care, cooperation</span></li>
          <li><strong>Connected communities</strong><span>sharing, learning, mutual support</span></li>
        </ol>
      </section>

      <section class="about-page__section">
        <h2>{exploring[0]}</h2>
        <p>{exploring[1]}</p>
      </section>

      <section class="about-page__section">
        <h2>{technology[0]}</h2>
        <p>{technology[1]}</p>
      </section>

      <section class="about-page__section">
        <h2>{held[0]}</h2>
        {heldParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <aside class="about-page__company" aria-labelledby="about-company-title">
          <p class="eyebrow">Company context</p>
          <h3 id="about-company-title">New Earth Advanced Technologies Ltd</h3>
          <p>Selected New Earth technology, engineering and product development.</p>
          <p>It sits within the wider New Earth context and does not replace New Earth as the public umbrella.</p>
        </aside>
        <aside class="about-page__founder" aria-labelledby="about-founder-title">
          <p class="eyebrow">Peter's journey</p>
          <h3 id="about-founder-title">Why I ended up building New Earth</h3>
          <p>New Earth did not start with a business plan.</p>
          <p>Peter's path through adversity, responsibility, rebuilding and eventually technology shaped much of what sits underneath the work today.</p>
          <a class="text-link" href="/founders-journey/">Read the Founder's Journey <span aria-hidden="true">&rarr;</span></a>
        </aside>
      </section>

      <section class="about-page__section about-page__conclusion">
        <h2>{starting[0]}</h2>
        <p>{starting[1]}</p>
        <nav class="about-page__actions" aria-label="Continue exploring">
          {page.links.map(([label, href], index) => <a class="button" class:list={index === 0 && 'about-page__primary-action'} href={href}>{label}</a>)}
        </nav>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page__hero { padding-block: clamp(5rem, 11vw, 8rem) clamp(3.5rem, 7vw, 5rem); }
  .about-page__hero .lede { max-width: 44rem; }
  .about-page__body { max-width: 920px; padding-bottom: 7rem; }
  .about-page__section { max-width: 760px; padding-block: clamp(2.75rem, 5vw, 4.25rem); border-top: 1px solid var(--line); }
  .about-page__section h2, .about-page__local-first h2 { max-width: 20ch; margin-bottom: 1.1rem; }
  .about-page__section p, .about-page__local-first p { max-width: 68ch; }
  .about-page__local-first { margin-block: 1rem; padding: clamp(2rem, 5vw, 3.5rem); border: 1px solid var(--line); border-left: 4px solid var(--teal); border-radius: var(--radius); background: linear-gradient(135deg, var(--sage), rgb(255 255 255 / .72)); box-shadow: var(--shadow); }
  .about-page__lead { color: var(--deep); font: 700 clamp(1.2rem, 2vw, 1.5rem)/1.35 var(--serif); }
  .about-page__path { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .about-page__path li { display: flex; min-width: 0; flex-direction: column; gap: .35rem; padding: 1rem; border-top: 2px solid var(--gold); background: rgb(255 255 255 / .7); }
  .about-page__path strong { color: var(--deep); }
  .about-page__path span { font-size: .88rem; line-height: 1.45; }
  .about-page__company { max-width: 680px; margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--sage); }
  .about-page__company h3 { margin-bottom: .7rem; }
  .about-page__company p { margin-block: .5rem; }
  .about-page__company .eyebrow { margin-top: 0; }
  .about-page__founder { max-width: 680px; margin-top: 1rem; padding: 1.5rem; border-left: 3px solid var(--gold); background: rgb(255 255 255 / .58); }
  .about-page__founder h3 { margin-bottom: .7rem; }
  .about-page__founder p { margin-block: .5rem; }
  .about-page__founder .eyebrow { margin-top: 0; }
  .about-page__founder .text-link { display: inline-flex; min-height: 44px; align-items: center; margin-top: .45rem; }
  .about-page__conclusion { max-width: 820px; }
  .about-page__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .about-page__primary-action { background: var(--deep); }
  @media (max-width: 760px) { .about-page__path { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .about-page__local-first { padding: 1.5rem; } .about-page__path { grid-template-columns: 1fr; } }
</style>
