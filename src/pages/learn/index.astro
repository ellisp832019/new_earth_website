---
import BaseLayout from '../../layouts/BaseLayout.astro';

const learnCategories = [
  {
    title: 'Understand New Earth',
    introduction: 'Explore the direction, principles and framework that connect New Earth’s purpose with practical questions.',
    pathways: [
      { title: 'The New Earth vision', contentType: 'Vision', description: 'Explore the developing direction and how awareness, responsibility and local capability inform it.', href: '/vision/', linkLabel: 'Explore the Vision' },
      { title: 'Principles behind the work', contentType: 'Principles', description: 'Read the principles connecting stewardship, human agency, technology and cooperation.', href: '/manifesto/', linkLabel: 'Read the Manifesto' },
      { title: 'Understanding the framework', contentType: 'Framework', description: 'Explore the Blueprint and its 12 Pillars as connected areas for questioning and learning.', href: '/blueprint/', linkLabel: 'Explore the Blueprint' },
      { title: 'Understanding the ecosystem', contentType: 'Ecosystem overview', description: 'See how selected areas of New Earth are described, including their responsibilities, implementation limits and human governance.', href: '/ecosystem/', linkLabel: 'Explore the Ecosystem' },
    ],
  },
  {
    title: 'Practical Knowledge',
    introduction: 'Use reflective questions, practical illustrations and a deliberate build method to connect understanding with action.',
    pathways: [
      { title: 'Starting with personal responsibility', contentType: 'Reflection', description: 'Use reflective questions about awareness, responsibility and the choices within personal control.', href: '/blueprint/inner-blueprint/', linkLabel: 'Read the Inner Blueprint' },
      { title: 'Understanding local capability', contentType: 'Practical illustration', description: 'Explore illustrations of how stewardship, local capability and wider cooperation could work in everyday life.', href: '/new-earth-in-practice/', linkLabel: 'See New Earth in Practice' },
      { title: 'How New Earth Builds', contentType: 'Build method', description: 'Explore a deliberate method for reusing existing work, defining boundaries, testing and reviewing evidence.', href: '/what-were-building/#how-new-earth-builds', linkLabel: 'Explore How New Earth Builds' },
    ],
  },
  {
    title: 'Follow the Evidence',
    introduction: 'Ask what is an idea, what is claimed, what has been tested and what the evidence supports. Current limitations matter too.',
    pathways: [
      { title: 'Explore project evidence', contentType: 'Project index', description: 'Browse selected projects with their current maturity, evidence and development limitations.', href: '/projects/', linkLabel: 'Explore Projects' },
      { title: 'Read Command Centre evidence', contentType: 'Project evidence', description: 'Examine current interface evidence alongside earlier development material and explicit limits on what it establishes.', href: '/projects/command-centre/', linkLabel: 'Read Command Centre evidence' },
    ],
  },
];
---

<BaseLayout
  title="Learn"
  description="Explore the New Earth framework, practical understanding and current project evidence, with clear limitations and useful starting points."
  canonical="/learn/"
>
  <article class="learn-page shell">
    <header class="learn-hero">
      <p class="eyebrow">Learn</p>
      <h1>Useful knowledge for practical understanding.</h1>
      <p class="lede">Start where useful: understand the framework, explore practical ideas or examine the evidence behind developing work. Learning should strengthen your knowledge, capability and informed choice, helping you take meaningful responsibility and cooperate with others.</p>
    </header>

    {learnCategories.map((category) => (
      <section class="learn-section" aria-labelledby={`learn-${category.title.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}>
        <div class="learn-section__intro">
          <p class="eyebrow">Choose where you want to start</p>
          <h2 id={`learn-${category.title.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}>{category.title}</h2>
          <p>{category.introduction}</p>
        </div>
        <div class="learn-pathways">
          {category.pathways.map((pathway) => (
            <article class="learn-card">
              <p class="learn-card__type">{pathway.contentType}</p>
              <h3>{pathway.title}</h3>
              <p>{pathway.description}</p>
              <a class="text-link" href={pathway.href}>{pathway.linkLabel} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="learn-section learn-section--journal" aria-labelledby="learn-journal">
      <div><p class="eyebrow">Journal</p><h2 id="learn-journal">The first entries are being prepared.</h2></div>
      <div>
        <p>No Journal articles are published yet. The Journal will add approved writing and learning context when there is something useful and accurate to publish.</p>
        <a class="text-link" href="/journal/">Visit the Journal <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .learn-page { padding-block: clamp(4rem, 9vw, 7rem); }
  .learn-hero { max-width: 760px; padding-bottom: clamp(3rem, 7vw, 5rem); }
  .learn-hero h1 { max-width: 16ch; }
  .learn-hero .lede { max-width: 65ch; }
  .learn-section { border-top: 1px solid var(--line); padding-block: clamp(2.75rem, 6vw, 5rem); }
  .learn-section__intro { max-width: 720px; }
  .learn-section h2 { max-width: 18ch; }
  .learn-section__intro > p:last-child { max-width: 65ch; }
  .learn-pathways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .learn-card { min-width: 0; padding: 1.35rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--sage); }
  .learn-card h3 { margin-block: .35rem .65rem; }
  .learn-card p { margin-bottom: 1.25rem; }
  .learn-card__type { margin: 0; color: var(--forest); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .learn-section--journal { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; padding-bottom: 0; }
  .learn-section--journal p { max-width: 62ch; }
  @media (max-width: 760px) { .learn-pathways, .learn-section--journal { grid-template-columns: 1fr; } }
  @media (max-width: 400px) { .learn-hero h1 { font-size: 2.4rem; } }
</style>
