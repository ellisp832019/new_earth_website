import LegalPage from '../../../components/LegalPage.astro';
const sections = [
  { heading: 'Who this information is for', paragraphs: ['This policy applies to the current public Website V2 operated under the New Earth name. New Earth is the wider public initiative and framework; the specific legal entity responsible for publication is recorded as an owner input still requiring confirmation.'] },
  { heading: 'Information collected through Contact V1', paragraphs: ['The Contact form collects the name, email address, selected route, selected subject, optional organisation and message supplied by a visitor. These details are used to read, route and respond to an enquiry. The form does not intentionally request a phone number, postal address, date of birth or account information.'] },
  { heading: 'How information is handled', paragraphs: ['The current handler does not create a website database or intentionally store submissions. Enquiry information may be present in the receiving mailbox and relevant correspondence for as long as reasonably necessary to handle the enquiry, maintain relevant correspondence or meet legitimate legal or operational requirements.'] },
  { heading: 'Cookies and technical information', paragraphs: ['The current Website V2 implementation does not add analytics, advertising trackers, marketing tags or newsletter enrolment. The site does not intentionally use localStorage or sessionStorage. A hosting environment may process technical information such as request time, IP address and browser or device information as part of ordinary security and server operation; the exact provider records and retention settings require staging verification.'], items: ['See the Cookie Policy for the current storage and tracking position.', 'Do not send passwords or other sensitive information through the Contact form.'] },
  { heading: 'External services', paragraphs: ['The current site uses ordinary links to external websites. Those services operate independently and have their own privacy practices. No external social feed, analytics service, advertising platform or embedded marketing service is added by this baseline.'] },
  { heading: 'Your rights', paragraphs: ['Depending on the circumstances, UK data-protection law may provide rights including access, correction, deletion, restriction, objection and data portability. Requests should be made through the public Contact route so they can be directed appropriately.'] },
  { heading: 'Privacy contact', paragraphs: ['Use the Contact page for a privacy question or request. A dedicated public privacy email address has not been verified and is not published here.'] },
];
