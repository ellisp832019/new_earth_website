---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssetImage from '../../components/AssetImage.astro';
import JournalArticleCard from '../../components/JournalArticleCard.astro';
import { journalCategories, publishedJournalArticles } from '../../data/journal';
import { assets } from '../../data/site';

const featured = publishedJournalArticles.find((article) => article.featured);
const recent = publishedJournalArticles.filter((article) => article !== featured);
---

<BaseLayout title="Journal" description="Building in Public: evidence-led updates, learning and context from the evolving New Earth work." canonical="/journal/" socialImagePath="/assets/journal_featured_home.webp" socialImageAlt="Conceptual editorial visual for the New Earth Journal and Building in Public."
>
  <article class="journal-page">
    <header class="shell journal-page__hero">
      <div><p class="eyebrow">Building in Public</p><h1>Journal</h1><p class="lede">A grounded record of what New Earth is building, learning, changing and still exploring.</p></div>
      <figure class="journal-page__figure"><AssetImage asset={assets.journal} alt="Conceptual editorial visual for the New Earth Journal" className="journal-page__visual" loading="eager" /></figure>
    </header>
    <section class="section section-sand" aria-labelledby="journal-purpose"><div class="shell journal-page__purpose"><div><p class="eyebrow">A useful record</p><h2 id="journal-purpose">Progress without performance theatre.</h2></div><div><p>The Journal documents practical work, project updates, research, Digital Products development and founder learning when there is something accurate and useful to share.</p><p>It is distinct from What We’re Building, which gives the current overview, and Projects, which holds deeper evidence and limitations. Journal entries add progress, history and learning without turning research or developing work into claims of availability.</p></div></div></section>
    <section class="section" aria-labelledby="journal-categories"><div class="shell"><p class="eyebrow">Browse by focus</p><h2 id="journal-categories">Controlled categories for future entries.</h2><nav class="category-list" aria-label="Journal categories">{journalCategories.map((category) => <a href={`/journal/category/${category.id}/`}><strong>{category.label}</strong><span>{category.description}</span></a>)}</nav></div></section>
    <section class="section section-sand" aria-labelledby="journal-entries"><div class="shell"><p class="eyebrow">Published entries</p><h2 id="journal-entries">{featured ? 'Latest from the Journal' : 'The first entries are still being prepared.'}</h2>{featured ? <div class="journal-featured"><JournalArticleCard article={featured} /></div> : <div class="journal-empty"><p>No Journal articles are published in this Website V2 baseline. Articles appear here only after their author, source, status and public wording are approved.</p><nav class="page-actions" aria-label="Continue exploring"><a class="button" href="/what-were-building/">See What We’re Building</a><a class="button button--outline" href="/projects/">Explore Projects</a></nav></div>}{recent.length ? <div class="journal-grid">{recent.map((article) => <JournalArticleCard article={article} />)}</div> : null}</div></section>
    <section class="section" aria-labelledby="journal-relationships"><div class="shell journal-page__relationships"><div><p class="eyebrow">Keep exploring</p><h2 id="journal-relationships">Follow the work at the right level.</h2></div><nav class="page-actions" aria-label="Journal related areas"><a class="button" href="/what-were-building/">What We’re Building</a><a class="button button--outline" href="/digital-products/">Digital Products</a><a class="text-link" href="/projects/microgrow/">MicroGrow evidence <span aria-hidden="true">→</span></a></nav></div></section>
  </article>
</BaseLayout>

<style>
  .journal-page__hero { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; padding-block: clamp(5rem, 10vw, 8rem); }
  .journal-page__figure { min-width: 0; margin: 0; }
  .journal-page__figure :global(.journal-page__visual) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); }
  .journal-page__purpose, .journal-page__relationships { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 7vw, 6rem); }
  .journal-page__purpose h2, .journal-page__relationships h2 { max-width: 18ch; }
  .category-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.75rem; }
  .category-list a { display: block; min-width: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--sage); color: inherit; padding: 1.25rem; text-decoration: none; }
  .category-list a:hover { border-color: var(--forest); }
  .category-list strong, .category-list span { display: block; }
  .category-list span { margin-top: .45rem; font-size: .9rem; line-height: 1.5; }
  .journal-featured { max-width: 760px; margin-top: 1.5rem; }
  .journal-empty { max-width: 700px; border-left: 3px solid var(--teal); padding-left: 1.25rem; }
  .journal-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .button--outline { border: 1px solid var(--forest); background: transparent; color: var(--forest); }
  @media (max-width: 760px) { .journal-page__hero, .journal-page__purpose, .journal-page__relationships { grid-template-columns: 1fr; } .category-list, .journal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .category-list, .journal-grid { grid-template-columns: 1fr; } }
</style>
