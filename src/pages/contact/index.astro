---
import BaseLayout from '../../layouts/BaseLayout.astro';

const status = Astro.url.searchParams.get('status');
const message = status === 'success'
  ? 'Thanks - your message has been sent. We\'ll read it and respond if a reply is needed.'
  : status === 'error'
    ? "We couldn't send your message just now. Please try again."
    : '';
---
<BaseLayout title="Contact New Earth | Get in Touch" description="Contact New Earth for aligned inquiry, collaboration, systems discussion, or interest in MicroGrow and the wider New Earth vision." canonical="/contact/">
  <article class="contact-page">
    <header class="page-hero shell contact-page__hero">
      <p class="eyebrow">Contact New Earth</p>
      <h1>Start a conversation</h1>
      <p class="lede">New Earth is being built through practical projects, collaboration, research, community and lived experience. Use the form below to get in touch and choose who or what your message is about.</p>
    </header>

    <div class="shell contact-page__layout">
      <section class="contact-page__context" aria-labelledby="contact-context-title">
        <p class="eyebrow">Choose a clear route</p>
        <h2 id="contact-context-title">Who this is for</h2>
        <div class="contact-page__routes">
          <article><h3>General / New Earth</h3><p>New Earth, community, wider collaboration or anything that does not fit elsewhere.</p></article>
          <article><h3>Peter</h3><p>Technology, MicroGrow, engineering, systems and related collaboration.</p></article>
          <article><h3>Hayley</h3><p>Conscious Living and aligned creator or community enquiries.</p></article>
        </div>
        <p class="contact-page__privacy">Your details will be used only to read and respond to your enquiry. This form does not subscribe you to a newsletter or mailing list. Full privacy-policy closure belongs to the next legal and privacy work package.</p>
      </section>

      <section class="contact-page__form-panel" aria-labelledby="contact-form-title">
        <h2 id="contact-form-title">Send an enquiry</h2>
        {message && <p class:list={['form-feedback', status === 'success' ? 'form-feedback--success' : 'form-feedback--error']} role="status" aria-live="polite">{message}</p>}
        <div id="contact-errors" class="form-feedback form-feedback--error" role="alert" tabindex="-1" hidden></div>
        <form id="contact-form" action="/contact-submit.php" method="post">
          <input type="hidden" name="form_started" id="form-started" value="0" />
          <div class="contact-page__trap" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <div class="form-field"><label for="name">Name <span aria-hidden="true">*</span></label><input id="name" name="name" type="text" maxlength="100" autocomplete="name" required /></div>
          <div class="form-field"><label for="email">Email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" maxlength="254" autocomplete="email" required /></div>
          <div class="form-field"><label for="audience">Who is this for? <span aria-hidden="true">*</span></label><select id="audience" name="audience" required><option value="">Choose a route</option><option>General / New Earth</option><option>Peter</option><option>Hayley</option></select></div>
          <div class="form-field"><label for="subject">Subject <span aria-hidden="true">*</span></label><select id="subject" name="subject" required><option value="">Choose a subject</option><option>General enquiry</option><option>Collaboration</option><option>MicroGrow</option><option>Technology &amp; systems</option><option>New Earth / community</option><option>Conscious Living</option><option>Media / interview</option><option>Other</option></select></div>
          <div class="form-field"><label for="organisation">Organisation <span class="optional">(optional)</span></label><input id="organisation" name="organisation" type="text" maxlength="150" autocomplete="organization" /></div>
          <div class="form-field"><label for="message">Message <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="8" maxlength="5000" required></textarea></div>
          <p class="form-note"><span aria-hidden="true">*</span> Required fields. Please do not include passwords or other sensitive information.</p>
          <button class="button" type="submit">Send enquiry</button>
        </form>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  const form = document.querySelector('#contact-form');
  const started = document.querySelector('#form-started');
  const errors = document.querySelector('#contact-errors');
  if (form instanceof HTMLFormElement && started instanceof HTMLInputElement && errors instanceof HTMLDivElement) {
    started.value = String(Date.now());
    form.addEventListener('submit', (event) => {
      const message = form.querySelector('#message');
      if (!(message instanceof HTMLTextAreaElement)) return;
      const problems = [];
      if (!form.checkValidity()) problems.push('Please complete the required fields and check your email address.');
      if (!message.value.trim()) problems.push('Please enter a message.');
      if (!problems.length) return;
      event.preventDefault();
      errors.textContent = problems.join(' ');
      errors.hidden = false;
      errors.focus();
    });
  }
</script>

<style>
  .contact-page__hero { padding-block: clamp(5rem, 11vw, 8rem) clamp(3.5rem, 7vw, 5rem); }
  .contact-page__hero .lede { max-width: 56rem; }
  .contact-page__layout { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(2rem, 7vw, 6rem); padding-bottom: 7rem; align-items: start; }
  .contact-page__context { padding-top: 1rem; }
  .contact-page__context h2, .contact-page__form-panel h2 { max-width: 18ch; }
  .contact-page__routes { display: grid; gap: 1rem; margin-top: 2rem; }
  .contact-page__routes article { padding: 1.25rem; border-top: 3px solid var(--teal); background: var(--sage); }
  .contact-page__routes h3 { margin-bottom: .45rem; font-size: 1.15rem; }
  .contact-page__routes p { margin: 0; }
  .contact-page__privacy { margin-top: 2rem; color: var(--forest); font-size: .92rem; }
  .contact-page__form-panel { padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--line); border-radius: var(--radius); background: var(--sage); box-shadow: var(--shadow); }
  .contact-page__form-panel h2 { margin-bottom: 1.5rem; }
  .contact-page__form-panel form { display: grid; gap: 1.15rem; }
  .form-field { display: grid; gap: .45rem; }
  .form-field label { color: var(--deep); font-weight: 700; }
  .form-field input, .form-field select, .form-field textarea { width: 100%; min-width: 0; box-sizing: border-box; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: .35rem; background: var(--ivory); color: var(--ink); font: inherit; }
  .form-field textarea { resize: vertical; }
  .form-field input:focus-visible, .form-field select:focus-visible, .form-field textarea:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .optional, .form-note { font-size: .9rem; font-weight: 400; }
  .form-note { margin: -.2rem 0 0; color: var(--forest); }
  .form-feedback { margin: 0 0 1.25rem; padding: 1rem; border: 1px solid var(--line); border-radius: .35rem; }
  .form-feedback--success { background: #e5f0e6; color: var(--deep); }
  .form-feedback--error { background: #fae9e4; color: #6e241c; }
  .contact-page__trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  @media (max-width: 760px) { .contact-page__layout { grid-template-columns: 1fr; } }
</style>
