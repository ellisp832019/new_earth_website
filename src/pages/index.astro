---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetImage from '../components/AssetImage.astro';
import { assets, pillars } from '../data/site';
---
<BaseLayout title="A More Conscious Way Forward" description="New Earth brings vision, practical systems and participation into one place." canonical="/">
  <section id="home-hero" class="home-hero"><AssetImage asset={assets.homeHero} alt="" className="hero-image" loading="eager" fetchpriority="high" /><div class="shell home-hero__content"><p class="eyebrow">A living framework for conscious civilisation</p><h1>A more conscious way forward.</h1><p class="lede">New Earth brings vision, practical systems, and participation into one place so people can understand what is possible and choose a meaningful next step.</p><div class="page-actions"><a class="button" href="/blueprint/">Explore the Blueprint</a><a class="button button-quiet" href="/projects/">See Projects</a></div></div></section>
  <section id="what-is-new-earth" class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">What is New Earth?</p><h2>A place to connect meaning with practice.</h2></div></div><div class="split"><AssetImage asset={assets.introduction} alt="Conceptual visual supporting the grounded New Earth introduction" className="story-image" /><div><p class="meta">CONCEPT CANDIDATE · Visual is illustrative, not documentary evidence</p><p class="lede">New Earth is a public framework for exploring the ideas, relationships, and projects that can support a more conscious civilisation. It is a place for clear questions, honest progress, and practical participation.</p><div class="page-actions"><a class="button" href="/vision/">Read the Vision</a><a class="text-link" href="/manifesto/">Read the Manifesto</a></div></div></div></div></section>
  <section id="pathways" class="section section-sand"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Start with the big picture</p><h2>Follow a clear path into the work.</h2></div></div><AssetImage asset={assets.blueprintHero} alt="A wide atmospheric view used as a visual introduction to the Blueprint pathway" className="wide-image" /><div class="card-grid five">{[['Vision','/vision/','Discover the direction and questions behind New Earth.'],['Blueprint','/blueprint/','Explore the framework that holds the vision together.'],['The 12 Pillars','/blueprint/pillars/','See how principles connect with every area of life.'],['Projects','/projects/','Explore ideas being researched and developed.'],['Get Involved','/get-involved/','Find a meaningful way to learn or contribute.']].map(([label,href,copy])=><a class="card" href={href}><h3>{label}</h3><p>{copy}</p></a>)}</div></div></section>
  <section id="pillars" class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">The 12 Pillars</p><h2>A framework for seeing the whole.</h2><p>Explore twelve interconnected areas of life through which the New Earth vision can be understood, questioned and developed.</p></div><a class="text-link" href="/blueprint/pillars/">View all pillars</a></div><div class="card-grid pillars">{[['01','Governance','governance','How we make decisions together.'],['02','Economics','economics','How value, resources, and exchange relate.'],['03','Education','education','How learning stays lifelong and alive.'],['04','Health and Healing','health-and-healing','How wellbeing is understood and supported.'],['05','Food and Agriculture','food-and-agriculture','How nourishment connects people and land.'],['06','Housing and Habitat','housing-and-habitat','How places can support belonging.'],['07','Energy and Technology','energy-and-technology','How tools can serve life and agency.'],['08','Justice and Conflict Transformation','justice-and-conflict-transformation','How harm, repair, and peace are held.'],['09','Media and Information','media-and-information','How knowledge and stories shape culture.'],['10','Environment and Relationship with Nature','environment-and-relationship-with-nature','How human life belongs within living systems.'],['11','Culture, Spirituality and Human Development','culture-spirituality-human-development','How inner and shared life can mature.'],['12','Family, Childhood and Eldership','family-childhood-eldership','How generations support one another.']].map(([number,label,slug,copy])=><a class="card" href={`/blueprint/pillars/${slug}/`}><span class="pillar-number">{number}</span><h3>{label}</h3><p>{copy}</p></a>)}</div></div></section>
  <section id="ecosystem" class="section section-sand"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Ecosystem</p><h2>See how New Earth fits together.</h2><p>New Earth connects a shared vision with practical frameworks, areas of life, developing projects and ways for people to participate.</p></div><a class="text-link" href="/ecosystem/">Explore the Ecosystem</a></div><div class="map"><div class="map-visual" aria-label="Visual relationship map represented with labelled HTML nodes"><span>Vision and Blueprint</span><span>12 Pillars</span><span>Projects</span><span>People and participation</span></div><div class="card"><h3>How the parts connect</h3><ul><li>The Vision gives New Earth its direction.</li><li>The Blueprint offers a shared framework.</li><li>The 12 Pillars connect it with major areas of life.</li><li>Projects explore how ideas might be applied.</li></ul></div></div></div></section>
  <section id="projects" class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Featured projects</p><h2>Explore what we're building.</h2><p>These projects are presented at their current stage, from early research and concepts to active development.</p></div><a class="text-link" href="/projects/">View Projects</a></div><div class="card-grid projects"><article class="image-content-card"><AssetImage asset={assets.microgrow} alt="Conceptual MicroGrow AI Lab prototype with edible plants, environmental sensors, local edge hardware and analytical monitoring" className="project-image" /><div><span class="status">Research</span><h3>MicroGrow AI Lab</h3><p>Exploring how growing systems, local intelligence and practical technology could work together.</p><a class="text-link" href="/projects/microgrow-ai-lab/">Explore project</a></div></article><article class="image-content-card"><AssetImage asset={assets.fieldScanner} alt="Conceptual handheld device for discovering and inspecting MicroGrow nodes" className="project-image" /><div><span class="status">Concept</span><h3>Field Scanner</h3><p>A handheld concept for discovering, identifying and inspecting connected MicroGrow nodes.</p><a class="text-link" href="/projects/field-scanner/">Explore project</a></div></article><article class="image-content-card"><AssetImage asset={assets.newEarthLiving} alt="Conceptual New Earth Living app visual connected to the Conscious Living ecosystem lane" className="project-image" /><div><span class="status">In development</span><h3>New Earth Living</h3><p>A developing app concept connecting people with the New Earth Conscious Living ecosystem.</p><a class="text-link" href="/projects/new-earth-living/">Explore project</a></div></article></div></div></section>
  <section id="progress" class="section section-sand"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Progress and Transparency</p><h2>Follow the work as it develops.</h2><p>New Earth is an evolving body of work. As updates become ready to share, they will be dated, placed in context and connected to the relevant part of the ecosystem.</p></div><a class="text-link" href="/progress/">View Progress and Transparency</a></div><div class="timeline"><article><p class="meta"><time datetime="2026-08-26">26 August 2026</time> · Owner: New Earth team</p><h3>V2 foundations taking shape</h3><p>Vision, structure and design decisions are being brought together for the next stage of the work.</p></article><article><p class="meta">Next update · Owner to be confirmed</p><h3>Homepage development</h3><p>As the work develops, future updates will share useful context and the next step.</p></article></div></div></section>
  <section id="journal" class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Journal and learning</p><h2>Follow the questions as they develop.</h2><p>Use the Journal and Resources routes to find future writing, guides, and learning material when they are approved and published.</p></div><a class="text-link" href="/journal/">Open Journal</a></div><div class="card-grid projects"><article class="image-content-card"><AssetImage asset={assets.journal} alt="Conceptual Journal editorial visual" className="project-image" /><div><span class="status">Editorial planned</span><h3>Journal</h3><p>The Journal will document questions, learning, progress and evolving New Earth work.</p><a class="text-link" href="/journal/">Open Journal</a></div></article><article class="image-content-card"><AssetImage asset={assets.resources} alt="Conceptual resources and practical learning visual" className="project-image" /><div><span class="status">Learning planned</span><h3>Resources</h3><p>This area will provide practical, beginner-friendly guides and learning material.</p><a class="text-link" href="/resources/">Explore resources</a></div></article><article class="image-content-card"><AssetImage asset={assets.faqGlossary} alt="Language and discovery visual for the FAQ and Glossary" className="project-image" /><div><span class="status">Reference</span><h3>FAQ &amp; Glossary</h3><p>Help visitors understand New Earth terminology and relationships.</p><a class="text-link" href="/resources/faq-glossary/">Open FAQ &amp; Glossary</a></div></article></div></div></section>
  <section id="get-involved" class="section section-sand"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Get Involved</p><h2>Find your way to take part.</h2><p>Start with understanding, then choose a clear route into the work.</p></div><a class="text-link" href="/get-involved/">Open Get Involved</a></div><div class="split involvement"><AssetImage asset={assets.community} alt="Community setting representing the welcoming participation context of Get Involved" className="story-image" /><div class="card-grid four"><a class="card" href="/resources/"><h3>Learn</h3><p>Explore the vision, Journal, resources and developing work.</p></a><a class="card" href="/community/"><h3>Contribute</h3><p>Offer knowledge, experience, time or practical support.</p></a><a class="card" href="/collaborate/"><h3>Collaborate</h3><p>Explore aligned partnerships and carefully defined work.</p></a><a class="card" href="/support/"><h3>Support</h3><p>Follow the journey and future ways to help projects develop.</p></a></div></div><article class="image-content-card builders-card"><div><span class="status">Independent community platform</span><h3>New Earth Builders</h3><p>An intentional community connecting innovators, healers, inventors and creators who want to collaborate, exchange knowledge and help bring New Earth-aligned projects into being.</p><a class="text-link" href="https://new-earth-builders.com/" target="_blank" rel="noopener noreferrer">Visit New Earth Builders <span aria-hidden="true">(external)</span></a></div><AssetImage asset={assets.builders} alt="New Earth Builders logo" className="builders-logo" /></article></div></section>
</BaseLayout>
