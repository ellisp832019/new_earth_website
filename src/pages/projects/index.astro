---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicProjects } from '../../data/projects';
const publicBuild = process.env.PUBLIC_ASSET_MODE === 'PUBLIC';
const visibleProjects = publicProjects.filter((project) => publicBuild ? project.publicEnabled && project.publicStatus === 'PUBLIC-ENABLED' : project.previewEnabled);
---
<BaseLayout title="Projects | New Earth" description="The public New Earth project index is being prepared with clear status and evidence." canonical="/projects/">
  <main class="projects-placeholder shell">
    <p class="eyebrow">Developing work</p>
    <h1>Projects</h1>
    <p class="lede">Projects are introduced one at a time with clear status, evidence and audience information as the work develops.</p>
    {visibleProjects.length > 0 && <div class="project-index-list">
      {visibleProjects.map((project) => <article class="card project-index-card"><div class="project-index-card__content">
        <p class="eyebrow">{project.maturity} · {project.publicStatus}</p>
        <h2>{project.name}</h2>
        <p>{project.shortDescription}</p>
        <a class="text-link" href={`/projects/${project.slug}/`}>Explore {project.name}</a>
        </div>
        {project.slug === 'microgrow' && <figure class="project-index-card__visual"><img src="/local-assets/microgrow_current_hardware_prototype.jpeg" alt="Current MicroGrow single-node prototype hardware." /></figure>}
      </article>)}
    </div>}
    <p><a class="button" href="/ecosystem/">Return to the Ecosystem</a></p>
  </main>
</BaseLayout>
<style>
  .projects-placeholder { max-width: 1120px; padding-block: clamp(5rem, 12vw, 9rem); }
  .projects-placeholder h1 { max-width: 12ch; }
  .projects-placeholder .lede { max-width: 52ch; }
  .project-index-list { display: grid; gap: 1.5rem; margin-block: 2.5rem; }
  .project-index-card { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .project-index-card__content { min-width: 0; }
  .project-index-card h2 { margin-block: .35rem .75rem; }
  .project-index-card p { max-width: 55ch; }
  .project-index-card__visual { width: 100%; max-width: 360px; margin: 0; justify-self: end; }
  .project-index-card__visual img { display: block; width: 100%; height: auto; max-width: 100%; max-height: 270px; object-fit: contain; border: 1px solid var(--line); border-radius: var(--radius); background: var(--ivory); }
  @media (max-width: 680px) { .project-index-card { grid-template-columns: 1fr; } .project-index-card__visual { justify-self: start; max-width: 360px; } }
</style>
