---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicProjects } from '../../data/projects';
const publicBuild = process.env.PUBLIC_ASSET_MODE === 'PUBLIC';
const visibleProjects = publicProjects.filter((project) => publicBuild ? project.publicEnabled && project.publicStatus === 'PUBLIC-ENABLED' : project.previewEnabled);
---
<BaseLayout title="Projects | New Earth" description="The public New Earth project index is being prepared with clear status and evidence." canonical="/projects/">
  <main class="projects-placeholder shell">
    <p class="eyebrow">Developing work</p>
    <h1>Projects</h1>
    <p class="lede">Projects are introduced one at a time with clear status, evidence and audience information as the work develops.</p>
    {visibleProjects.length > 0 && <div class="project-index-list">
      {visibleProjects.map((project) => <article class="card project-index-card">
        <p class="eyebrow">{project.maturity} · {project.publicStatus}</p>
        <h2>{project.name}</h2>
        <p>{project.shortDescription}</p>
        <a class="text-link" href={`/projects/${project.slug}/`}>Explore {project.name}</a>
      </article>)}
    </div>}
    <p><a class="button" href="/ecosystem/">Return to the Ecosystem</a></p>
  </main>
</BaseLayout>
<style>
  .projects-placeholder { max-width: 760px; padding-block: clamp(5rem, 12vw, 9rem); }
  .projects-placeholder h1 { max-width: 12ch; }
  .projects-placeholder .lede { max-width: 52ch; }
  .project-index-list { display: grid; gap: 1.5rem; margin-block: 2.5rem; }
  .project-index-card { padding: 1.5rem; }
  .project-index-card h2 { margin-block: .35rem .75rem; }
  .project-index-card p { max-width: 55ch; }
</style>
