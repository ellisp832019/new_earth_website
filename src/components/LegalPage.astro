---
import BaseLayout from '../layouts/BaseLayout.astro';

type Section = { heading: string; paragraphs?: string[]; items?: string[] };
interface Props { title: string; description: string; updated: string; intro: string; sections: Section[]; links?: { label: string; href: string }[] }
const { title, description, updated, intro, sections, links = [] } = Astro.props as Props;
---
<BaseLayout title={title} description={description} canonical={Astro.url.pathname}>
  <article class="legal-page">
    <header class="page-hero shell legal-page__hero">
      <p class="eyebrow">Legal information</p>
      <h1>{title}</h1>
      <p class="lede">{intro}</p>
      <p class="legal-page__date">Last updated: {updated}</p>
    </header>
    <div class="shell legal-page__body">
      {sections.map((section) => <section aria-labelledby={`${section.heading.toLowerCase().replaceAll(' ', '-')}`}>
        <h2 id={section.heading.toLowerCase().replaceAll(' ', '-')}>{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
        {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
      </section>)}
      {links.length > 0 && <nav class="page-actions" aria-label="Legal information"><a class="button" href="/legal/">Legal information</a>{links.map((link) => <a class="text-link" href={link.href}>{link.label}</a>)}</nav>}
    </div>
  </article>
</BaseLayout>
<style>
  .legal-page__hero { padding-block: clamp(4rem, 9vw, 7rem) 3rem; }
  .legal-page__hero .lede { max-width: 62ch; }
  .legal-page__date { color: var(--forest); font-size: .9rem; }
  .legal-page__body { max-width: 820px; padding-bottom: 7rem; }
  .legal-page__body section { padding-block: 2rem; border-top: 1px solid var(--line); }
  .legal-page__body h2 { font-size: clamp(1.6rem, 3vw, 2.35rem); }
  .legal-page__body p, .legal-page__body li { max-width: 72ch; }
  .legal-page__body ul { padding-left: 1.25rem; }
  .legal-page__body li + li { margin-top: .45rem; }
</style>
