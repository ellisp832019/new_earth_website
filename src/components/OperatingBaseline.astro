  @media (max-width: 640px) { .operating-baseline__two-column, .operating-baseline__responsibilities, .operating-baseline__distinctions, .operating-baseline__direction-list, .operating-baseline__questions, .operating-baseline__proofs, .operating-baseline__cycle { grid-template-columns: 1fr; } }
</style>
