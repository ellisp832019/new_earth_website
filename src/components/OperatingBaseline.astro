  .operating-baseline__authority h2, .operating-baseline__authority .eyebrow { color: var(--ivory); }
  .operating-baseline__authority .eyebrow { color: #e2c98b; }
  .operating-baseline__direction-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; padding: 0; list-style: none; }
  .operating-baseline__direction-list li { padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--sage); }
  .operating-baseline__direction-list strong, .operating-baseline__direction-list span { display: block; }
  .operating-baseline__direction-list span { margin-top: .3rem; }
  .operating-baseline__questions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2rem; margin-top: 1.75rem; padding-left: 1.5rem; }
  .operating-baseline__questions li { padding-left: .25rem; }
  .operating-baseline__questions strong, .operating-baseline__questions span { display: block; }
  .operating-baseline__questions span { margin-top: .3rem; }
