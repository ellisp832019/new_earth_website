  .operating-baseline__cycle-caption { max-width: 68ch; font-weight: 700; }
  .operating-baseline__cycle { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: .75rem; margin: 2rem 0 0; padding: 0; list-style: none; }
