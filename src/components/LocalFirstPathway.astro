---
const stages = [
  {
    title: 'Person',
    description: 'Awareness, wellbeing, learning and practical agency begin with a person and the choices available to them.',
    relationship: 'Personal understanding becomes a foundation for caring for a home, place and the people nearby.',
    links: [['About New Earth', '/about/'], ['Read the Manifesto', '/manifesto/']],
  },
  {
    title: 'Home / Place',
    description: 'A home or cared-for place is where needs such as food, resources, habitat and environment become tangible.',
    relationship: 'Practical care close to home can reveal what is maintainable locally and what benefits from shared effort.',
    links: [['MicroGrow prototype', '/projects/microgrow/'], ['The 12 Pillars', '/blueprint/']],
  },
  {
    title: 'Community',
    description: 'People can cooperate around shared knowledge, spaces, care, participation and local priorities.',
    relationship: 'Community connects individual agency with capability that no person or household needs to build alone.',
    links: [['Ways to participate', '/get-involved/'], ['Contact New Earth', '/contact/']],
  },
  {
    title: 'Local capability',
    description: 'Skills, tools, projects and understanding can help a place maintain more of what people depend on.',
    relationship: 'Capability is strengthened by evidence, clear limits and human responsibility, not by claims of finished integration.',
    links: [['Explore projects', '/projects/'], ['Command Centre', '/projects/command-centre/']],
  },
  {
    title: 'Connected communities',
    description: 'Local-first communities can share learning, resources and mutual support without giving up meaningful local agency.',
    relationship: 'Connection allows useful patterns to travel while leaving room for different places and circumstances.',
    links: [['Explore the ecosystem', '/ecosystem/'], ['Get involved', '/get-involved/']],
  },
  {
    title: 'Wider New Earth',
    description: 'A wider New Earth could grow through cooperation between capable people, places and communities.',
    relationship: 'This is a future direction held by the Vision and Blueprint, not a claim of a completed global system.',
    links: [['Read the Vision', '/vision/'], ['Explore the Blueprint', '/blueprint/']],
  },
] as const;
---
<section class="local-pathway" aria-labelledby="local-pathway-title">
  <div class="local-pathway__intro">
    <p class="eyebrow">Explore the local-first pathway</p>
    <h2 id="local-pathway-title">From the person to a wider New Earth</h2>
    <p>Select a stage to see how local capability can connect outward. This is an illustrative pathway, not a claim of completed deployment.</p>
  </div>
  <div class="local-pathway__stages">
    {stages.map((stage, index) => (
      <details class="local-pathway__stage" name="local-first-pathway" open={index === 0}>
        <summary>
          <span class="local-pathway__number">Stage {index + 1} of {stages.length}</span>
          <strong>{stage.title}</strong>
        </summary>
        <div class="local-pathway__detail">
          <p>{stage.description}</p>
          <p><strong>Connection:</strong> {stage.relationship}</p>
          <nav aria-label={`${stage.title} related pages`}>
            {stage.links.map(([label, href]) => <a class="text-link" href={href}>{label}</a>)}
          </nav>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .local-pathway { margin-bottom: clamp(2.75rem, 6vw, 5rem); padding: clamp(1.4rem, 4vw, 2.5rem); border: 1px solid var(--line); border-top: 4px solid var(--context-accent); border-radius: var(--radius); background: var(--context-surface); }
  .local-pathway__intro { max-width: 720px; }
  .local-pathway__intro h2 { max-width: 18ch; }
  .local-pathway__intro > p:last-child { max-width: 65ch; }
  .local-pathway__stages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: 2rem; counter-reset: pathway; }
  .local-pathway__stage { position: relative; min-width: 0; border: 1px solid var(--line); border-radius: calc(var(--radius) - 2px); background: color-mix(in srgb, var(--ivory) 88%, transparent); }
  .local-pathway__stage summary { min-height: 5.5rem; padding: 1rem 2.4rem 1rem 1rem; cursor: pointer; list-style: none; }
  .local-pathway__stage summary::-webkit-details-marker { display: none; }
  .local-pathway__stage summary::after { content: '+'; position: absolute; top: 1rem; right: 1rem; color: var(--forest); font-size: 1.25rem; font-weight: 700; line-height: 1; }
  .local-pathway__stage[open] { border-color: var(--context-accent); box-shadow: var(--shadow); }
  .local-pathway__stage[open] summary::after { content: '−'; }
  .local-pathway__stage summary:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .local-pathway__number, .local-pathway__stage summary strong { display: block; }
  .local-pathway__number { margin-bottom: .25rem; color: var(--forest); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .local-pathway__stage summary strong { color: var(--deep); font-family: var(--serif); font-size: 1.12rem; }
  .local-pathway__detail { padding: 0 1rem 1.15rem; border-top: 1px solid var(--line); }
  .local-pathway__detail p { font-size: .93rem; }
  .local-pathway__detail nav { display: flex; flex-wrap: wrap; gap: .6rem 1rem; }
  @media (max-width: 820px) { .local-pathway__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .local-pathway { padding: 1.15rem; } .local-pathway__stages { grid-template-columns: 1fr; } .local-pathway__stage summary { min-height: 4.75rem; } }
</style>
