---
const stages = [
  {
    title: 'Person',
    description: 'Awareness, wellbeing, learning and practical agency begin with a person and the choices available to them.',
    relationship: 'Personal understanding becomes a foundation for caring for a home, place and the people nearby.',
    links: [['About New Earth', '/about/'], ['Read the Manifesto', '/manifesto/']],
  },
  {
    title: 'Home / Place',
    description: 'A home or cared-for place is where needs such as food, resources, habitat and environment become tangible.',
    relationship: 'Practical care close to home can reveal what is maintainable locally and what benefits from shared effort.',
    links: [['MicroGrow prototype', '/projects/microgrow/'], ['The 12 Pillars', '/blueprint/pillars/']],
  },
  {
    title: 'Community',
    description: 'People can cooperate around shared knowledge, spaces, care, participation and local priorities.',
    relationship: 'Community connects individual agency with capability that no person or household needs to build alone.',
    links: [['Ways to participate', '/get-involved/'], ['Contact New Earth', '/contact/']],
  },
  {
    title: 'Local capability',
    description: 'Skills, tools, projects and understanding can help a place maintain more of what people depend on.',
    relationship: 'Capability is strengthened by evidence, clear limits and human responsibility, not by claims of finished integration.',
    links: [['Explore projects', '/projects/'], ['Command Centre', '/projects/command-centre/']],
  },
  {
    title: 'Connected communities',
    description: 'Local-first communities can share learning, resources and mutual support without giving up meaningful local agency.',
    relationship: 'Connection allows useful patterns to travel while leaving room for different places and circumstances.',
    links: [['Explore the ecosystem', '/ecosystem/'], ['Get involved', '/get-involved/']],
  },
  {
    title: 'Wider New Earth',
    description: 'A wider New Earth could grow through cooperation between capable people, places and communities.',
    relationship: 'This is a future direction held by the Vision and Blueprint, not a claim of a completed global system.',
    links: [['Read the Vision', '/vision/'], ['Explore the Blueprint', '/blueprint/']],
  },
] as const;
---
<section class="local-pathway" aria-labelledby="local-pathway-title">
  <div class="local-pathway__intro">
    <p class="eyebrow">Explore the local-first pathway</p>
    <h2 id="local-pathway-title">From the person to a wider New Earth</h2>
    <p>Select a stage to see how local capability can connect outward. This is an illustrative pathway, not a claim of completed deployment.</p>
  </div>
  <div class="local-pathway__enhanced" data-pathway-enhanced hidden>
    <div class="local-pathway__track" aria-label="Local-first pathway stages">
      {stages.map((stage, index) => (
        <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="local-pathway-shared-detail" data-pathway-select={index}>
          <span class="local-pathway__track-number" aria-hidden="true">{index + 1}</span>
          <span class="local-pathway__track-title">{stage.title}</span>
          <span class="local-pathway__current" hidden={index !== 0}>Current stage</span>
        </button>
      ))}
    </div>
    <article class="local-pathway__shared-detail" id="local-pathway-shared-detail" aria-live="polite">
      <div>
        <p class="local-pathway__shared-stage" data-pathway-stage>Stage 1 of {stages.length} · Current stage</p>
        <h3 data-pathway-title>{stages[0].title}</h3>
      </div>
      <div>
        <p data-pathway-description>{stages[0].description}</p>
        <p><strong>Connection:</strong> <span data-pathway-relationship>{stages[0].relationship}</span></p>
        <nav aria-label={`${stages[0].title} related pages`} data-pathway-links>
          {stages[0].links.map(([label, href]) => <a class="text-link" href={href}>{label}</a>)}
        </nav>
      </div>
    </article>
  </div>
  <div class="local-pathway__stages" data-pathway-fallback>
    {stages.map((stage, index) => (
      <details class="local-pathway__stage" name="local-first-pathway" open={index === 0} data-pathway-source={index}>
        <summary>
          <span class="local-pathway__number">Stage {index + 1} of {stages.length}</span>
          <strong>{stage.title}</strong>
        </summary>
        <div class="local-pathway__detail">
          <p>{stage.description}</p>
          <p><strong>Connection:</strong> {stage.relationship}</p>
          <nav aria-label={`${stage.title} related pages`}>
            {stage.links.map(([label, href]) => <a class="text-link" href={href}>{label}</a>)}
          </nav>
        </div>
      </details>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.local-pathway').forEach((pathway) => {
    const enhanced = pathway.querySelector<HTMLElement>('[data-pathway-enhanced]');
    const sources = Array.from(pathway.querySelectorAll<HTMLDetailsElement>('[data-pathway-source]'));
    const buttons = Array.from(pathway.querySelectorAll<HTMLButtonElement>('[data-pathway-select]'));
    const stageLabel = pathway.querySelector<HTMLElement>('[data-pathway-stage]');
    const title = pathway.querySelector<HTMLElement>('[data-pathway-title]');
    const description = pathway.querySelector<HTMLElement>('[data-pathway-description]');
    const relationship = pathway.querySelector<HTMLElement>('[data-pathway-relationship]');
    const links = pathway.querySelector<HTMLElement>('[data-pathway-links]');
    if (!enhanced || !stageLabel || !title || !description || !relationship || !links) return;

    const selectStage = (index: number) => {
      const source = sources[index];
      if (!source) return;
      buttons.forEach((button, buttonIndex) => {
        const selected = buttonIndex === index;
        button.setAttribute('aria-pressed', String(selected));
        const current = button.querySelector<HTMLElement>('.local-pathway__current');
        if (current) current.hidden = !selected;
      });
      stageLabel.textContent = `Stage ${index + 1} of ${sources.length} · Current stage`;
      title.textContent = source.querySelector('summary strong')?.textContent ?? '';
      description.textContent = source.querySelector('.local-pathway__detail > p')?.textContent ?? '';
      relationship.textContent = source.querySelector('.local-pathway__detail > p:nth-of-type(2)')?.textContent?.replace(/^Connection:\s*/, '') ?? '';
      const sourceLinks = Array.from(source.querySelectorAll<HTMLAnchorElement>('a'));
      links.replaceChildren(...sourceLinks.map((link) => link.cloneNode(true)));
      links.setAttribute('aria-label', `${title.textContent} related pages`);
    };

    enhanced.hidden = false;
    pathway.classList.add('is-enhanced');
    buttons.forEach((button, index) => button.addEventListener('click', () => selectStage(index)));
  });
</script>

<style>
  .local-pathway { margin-bottom: clamp(2.75rem, 6vw, 5rem); padding: clamp(1.4rem, 4vw, 2.5rem); border: 1px solid var(--line); border-top: 4px solid var(--context-accent); border-radius: var(--radius); background: var(--context-surface); }
  .local-pathway__intro { max-width: 720px; }
  .local-pathway__intro h2 { max-width: 18ch; }
  .local-pathway__intro > p:last-child { max-width: 65ch; }
  .local-pathway__enhanced[hidden] { display: none; }
  .local-pathway__enhanced { margin-top: 2rem; }
  .local-pathway__track { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(.4rem, 1vw, .75rem); }
  .local-pathway__track::before { content: ''; position: absolute; top: 2rem; right: 4%; left: 4%; height: 1px; background: color-mix(in srgb, var(--context-accent) 55%, var(--line)); }
  .local-pathway__track button { position: relative; z-index: 1; display: grid; align-content: start; justify-items: center; min-width: 0; min-height: 7rem; padding: .7rem .5rem .65rem; border: 1px solid var(--line); border-radius: calc(var(--radius) - 4px); background: var(--ivory); color: var(--deep); cursor: pointer; text-align: center; transition: border-color var(--motion-quick) ease, box-shadow var(--motion-calm) ease, transform var(--motion-calm) ease; }
  .local-pathway__track button:not(:last-child)::after { content: '›'; position: absolute; top: 1.35rem; right: calc(clamp(.4rem, 1vw, .75rem) * -.72); color: var(--forest); font-size: 1.1rem; font-weight: 800; }
  .local-pathway__track button:hover, .local-pathway__track button:focus-visible { border-color: var(--context-accent); transform: translateY(-2px); }
  .local-pathway__track button[aria-pressed="true"] { border-color: var(--context-accent); box-shadow: inset 0 3px var(--context-accent), var(--shadow); }
  .local-pathway__track-number { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; margin-bottom: .55rem; border: 1px solid var(--context-accent); border-radius: 50%; background: var(--context-surface); font-size: .78rem; font-weight: 800; }
  .local-pathway__track-title { font-family: var(--serif); font-size: clamp(.85rem, 1.15vw, 1.02rem); font-weight: 700; line-height: 1.2; }
  .local-pathway__current { margin-top: .35rem; color: var(--forest); font-size: .58rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .local-pathway__shared-detail { display: grid; grid-template-columns: minmax(180px, .65fr) minmax(0, 1.35fr); gap: clamp(1.5rem, 4vw, 3rem); margin-top: 1rem; padding: clamp(1.25rem, 3vw, 2rem); border-left: 4px solid var(--context-accent); border-radius: calc(var(--radius) - 2px); background: var(--ivory); box-shadow: var(--shadow); }
  .local-pathway__shared-stage { margin: 0 0 .45rem; color: var(--forest); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .local-pathway__shared-detail h3 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.25rem); }
  .local-pathway__shared-detail p:first-child { margin-top: 0; }
  .local-pathway__shared-detail nav { display: flex; flex-wrap: wrap; gap: .6rem 1rem; }
  .local-pathway__stages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: 2rem; counter-reset: pathway; }
  .local-pathway.is-enhanced .local-pathway__stages { display: none; }
  .local-pathway__stage { position: relative; min-width: 0; border: 1px solid var(--line); border-radius: calc(var(--radius) - 2px); background: color-mix(in srgb, var(--ivory) 88%, transparent); }
  .local-pathway__stage summary { min-height: 5.5rem; padding: 1rem 2.4rem 1rem 1rem; cursor: pointer; list-style: none; }
  .local-pathway__stage summary::-webkit-details-marker { display: none; }
  .local-pathway__stage summary::after { content: '+'; position: absolute; top: 1rem; right: 1rem; color: var(--forest); font-size: 1.25rem; font-weight: 700; line-height: 1; }
  .local-pathway__stage[open] { border-color: var(--context-accent); box-shadow: var(--shadow); }
  .local-pathway__stage[open] summary::after { content: '−'; }
  .local-pathway__stage summary:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .local-pathway__number, .local-pathway__stage summary strong { display: block; }
  .local-pathway__number { margin-bottom: .25rem; color: var(--forest); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .local-pathway__stage summary strong { color: var(--deep); font-family: var(--serif); font-size: 1.12rem; }
  .local-pathway__detail { padding: 0 1rem 1.15rem; border-top: 1px solid var(--line); }
  .local-pathway__detail p { font-size: .93rem; }
  .local-pathway__detail nav { display: flex; flex-wrap: wrap; gap: .6rem 1rem; }
  @media (max-width: 820px) { .local-pathway.is-enhanced .local-pathway__enhanced { display: none; } .local-pathway.is-enhanced .local-pathway__stages { display: grid; } .local-pathway__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .local-pathway { padding: 1.15rem; } .local-pathway__stages { grid-template-columns: 1fr; } .local-pathway__stage summary { min-height: 4.75rem; } }
  @media (prefers-reduced-motion: reduce) { .local-pathway__track button { transition: none; } .local-pathway__track button:hover, .local-pathway__track button:focus-visible { transform: none; } }
</style>
