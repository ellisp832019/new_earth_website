---
import { assetUrl } from '../lib/asset-resolver';
const { asset, src: directSrc, alt, className = '', loading = 'lazy', fetchpriority, caption = '' } = Astro.props;
const src = directSrc || (asset && assetUrl(asset));
---
{src && <button class="lightbox-trigger" type="button" data-lightbox data-lightbox-alt={alt} data-lightbox-caption={caption} aria-label={`Open larger view: ${alt}`}>
  <img class={className} src={src} alt={alt} loading={loading} fetchpriority={fetchpriority} />
</button>}
