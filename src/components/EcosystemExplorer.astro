---
const nodes = [
  {
    id: 'direction',
    group: 'Vision / Blueprint',
    name: 'Vision and Blueprint',
    maturity: 'PUBLIC INFORMATION ONLY',
    description: 'The direction, principles and connected framework that help explain why New Earth exists.',
    relationship: 'Provides shared direction for practice, projects and participation without claiming finished implementation.',
    href: '/blueprint/',
    linkLabel: 'Explore the Blueprint',
    related: ['practice', 'microgrow', 'command-centre', 'participation'],
  },
  {
    id: 'practice',
    group: 'Living / practice',
    name: 'New Earth in Practice',
    maturity: 'PUBLIC INFORMATION ONLY',
    description: 'An illustrative local-first model connecting people, places, communities and wider cooperation.',
    relationship: 'Translates the wider direction into practical questions and links it to projects and participation.',
    href: '/new-earth-in-practice/',
    linkLabel: 'Explore New Earth in Practice',
    related: ['direction', 'microgrow', 'participation'],
  },
  {
    id: 'microgrow',
    group: 'Projects / products',
    name: 'MicroGrow',
    maturity: 'PROTOTYPE',
    description: 'A single-node growing-environment project exploring local monitoring, control and diagnostics.',
    relationship: 'Offers a bounded example of a project developing local capability; it is not a finished ecosystem integration.',
    href: '/projects/microgrow/',
    linkLabel: 'View MicroGrow evidence',
    related: ['practice', 'command-centre'],
  },
  {
    id: 'command-centre',
    group: 'Engineering / systems',
    name: 'New Earth Command Centre',
    maturity: 'ACTIVE DEVELOPMENT',
    description: 'A developing Windows desktop control and navigation surface for parts of the technical ecosystem.',
    relationship: 'Explores visible system discovery and control while remaining distinct from the projects and services it may describe.',
    href: '/projects/command-centre/',
    linkLabel: 'View Command Centre evidence',
    related: ['direction', 'microgrow'],
  },
  {
    id: 'participation',
    group: 'Community / participation',
    name: 'Participation pathways',
    maturity: 'PUBLIC INFORMATION ONLY',
    description: 'Public ways to learn, contribute, collaborate and begin from a person’s real interests and capacity.',
    relationship: 'Connects the framework and practical work with people; participation does not depend on a completed platform.',
    href: '/get-involved/',
    linkLabel: 'See ways to participate',
    related: ['direction', 'practice'],
  },
] as const;
---
<section class="ecosystem-explorer shell" aria-labelledby="ecosystem-explorer-title" data-ecosystem-explorer>
  <div class="ecosystem-explorer__intro">
    <p class="eyebrow">Explore public relationships</p>
    <h3 id="ecosystem-explorer-title">Follow one part of the ecosystem</h3>
    <p>Select a card to highlight its closest public relationships. Every card includes its current maturity, boundary and safe canonical route.</p>
  </div>
  <p class="ecosystem-explorer__status" aria-live="polite" data-explorer-status>All public relationship cards are shown below.</p>
  <div class="ecosystem-explorer__grid">
    {nodes.map((node) => (
      <article class="ecosystem-explorer__card" data-node={node.id}>
        <p class="ecosystem-explorer__group">{node.group}</p>
        <span class="ecosystem-explorer__action">Explore area</span>
        <h4><button type="button" disabled aria-pressed="false" data-related={node.related.join(',')} data-name={node.name}><span data-node-title>{node.name}</span></button></h4>
        <p class="ecosystem-explorer__maturity">{node.maturity}</p>
        <p>{node.description}</p>
        <p class="ecosystem-explorer__relationship"><strong>How it relates:</strong> {node.relationship}</p>
        <a class="text-link" href={node.href}>{node.linkLabel}</a>
      </article>
    ))}
    <span class="ecosystem-explorer__connector ecosystem-explorer__connector--direction" aria-hidden="true">Direction into practice and projects ↓</span>
    <span class="ecosystem-explorer__connector ecosystem-explorer__connector--participation" aria-hidden="true">Direction and practice connect to participation ↓</span>
  </div>
</section>

<script>
  document.querySelectorAll('[data-ecosystem-explorer]').forEach((explorer) => {
    const cards = Array.from(explorer.querySelectorAll<HTMLElement>('[data-node]'));
    const status = explorer.querySelector<HTMLElement>('[data-explorer-status]');
    cards.forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('button[data-related]');
      if (!button) return;
      button.disabled = false;
      button.addEventListener('click', () => {
        const selected = button.getAttribute('aria-pressed') !== 'true';
        const related = selected ? (button.dataset.related ?? '').split(',') : [];
        cards.forEach((candidate) => {
          const candidateButton = candidate.querySelector<HTMLButtonElement>('button[data-related]');
          const isSelected = selected && candidate === card;
          candidate.classList.toggle('is-selected', isSelected);
          candidate.classList.toggle('is-related', selected && related.includes(candidate.dataset.node ?? ''));
          candidateButton?.setAttribute('aria-pressed', String(isSelected));
        });
        if (status) {
          const names = cards.filter((candidate) => candidate.classList.contains('is-related')).map((candidate) => candidate.querySelector('[data-node-title]')?.textContent).filter(Boolean);
          status.textContent = selected ? `${button.dataset.name} is selected. Closest public relationships: ${names.join(', ')}.` : 'All public relationship cards are shown below.';
        }
      });
    });
  });
</script>

<style>
  .ecosystem-explorer { max-width: 1180px; padding-block: 3rem; border-bottom: 1px solid var(--line); }
  .ecosystem-explorer__intro { max-width: 740px; }
  .ecosystem-explorer__intro h3 { font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .ecosystem-explorer__status { max-width: 76ch; min-height: 1.7em; margin: 1.5rem 0 1rem; padding-left: .8rem; border-left: 3px solid var(--teal); color: var(--forest); font-size: .92rem; }
  .ecosystem-explorer__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .7rem 1.5rem; align-items: stretch; padding-block: .75rem; }
  .ecosystem-explorer__card { position: relative; z-index: 1; min-width: 0; padding: 1.35rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--ivory); box-shadow: 0 10px 28px rgb(23 55 47 / .07); transition: border-color var(--motion-quick) ease, box-shadow var(--motion-calm) ease, transform var(--motion-calm) ease; }
  .ecosystem-explorer__card[data-node="direction"] { grid-column: 3 / 5; grid-row: 1; }
  .ecosystem-explorer__card[data-node="practice"] { grid-column: 1 / 3; grid-row: 3; }
  .ecosystem-explorer__card[data-node="microgrow"] { grid-column: 3 / 5; grid-row: 3; }
  .ecosystem-explorer__card[data-node="command-centre"] { grid-column: 5 / 7; grid-row: 3; }
  .ecosystem-explorer__card[data-node="participation"] { grid-column: 3 / 5; grid-row: 5; }
  .ecosystem-explorer__card[data-node="practice"]::after, .ecosystem-explorer__card[data-node="microgrow"]::after { content: '↔'; position: absolute; top: 50%; right: -1.55rem; width: 1.55rem; color: var(--teal); font-size: 1rem; font-weight: 800; text-align: center; transform: translateY(-50%); }
  .ecosystem-explorer__card::before { position: absolute; top: 1rem; right: 1rem; padding: .16rem .42rem; border-radius: 999px; background: var(--sage); color: var(--deep); font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .ecosystem-explorer__card.is-selected { border-color: var(--teal); box-shadow: inset 0 3px var(--teal), var(--shadow); transform: translateY(-2px); }
  .ecosystem-explorer__card.is-selected::before { content: 'Selected'; }
  .ecosystem-explorer__card.is-related { border-color: var(--gold); box-shadow: inset 0 3px var(--gold), 0 10px 28px rgb(23 55 47 / .07); }
  .ecosystem-explorer__card.is-related::before { content: 'Related'; }
  .ecosystem-explorer__group, .ecosystem-explorer__maturity { margin: 0 0 .45rem; color: var(--forest); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .ecosystem-explorer__maturity { width: max-content; margin-top: .85rem; padding: .2rem .48rem; border: 1px solid var(--line); border-radius: 999px; background: var(--sage); color: var(--ink); }
  .ecosystem-explorer__action { display: block; color: var(--forest); font-size: .66rem; font-weight: 800; letter-spacing: .1em; line-height: 1.35; text-transform: uppercase; }
  .ecosystem-explorer__card h4 { margin: .05rem 0 .35rem; }
  .ecosystem-explorer__card button { width: 100%; min-height: 2.75rem; padding: 0; border: 0; background: transparent; color: var(--deep); cursor: pointer; font: 700 1.32rem/1.2 var(--serif); text-align: left; }
  .ecosystem-explorer__card button > span { text-decoration: underline transparent; text-underline-offset: .22em; transition: text-decoration-color var(--motion-quick) ease; }
  .ecosystem-explorer__card button:disabled { color: var(--deep); cursor: default; }
  .ecosystem-explorer__card button:not(:disabled):hover > span, .ecosystem-explorer__card button:not(:disabled):focus-visible > span, .ecosystem-explorer__card button[aria-pressed="true"] > span { text-decoration-color: var(--teal); }
  .ecosystem-explorer__relationship { padding-top: .75rem; border-top: 1px solid var(--line); font-size: .92rem; }
  .ecosystem-explorer__connector { display: grid; place-items: center; min-height: 2rem; color: var(--forest); font-size: .68rem; font-weight: 800; letter-spacing: .07em; text-align: center; text-transform: uppercase; }
  .ecosystem-explorer__connector--direction { grid-column: 3 / 5; grid-row: 2; }
  .ecosystem-explorer__connector--participation { grid-column: 3 / 5; grid-row: 4; }
  @media (max-width: 820px) {
    .ecosystem-explorer__grid { grid-template-columns: 1fr; gap: 1rem; }
    .ecosystem-explorer__card[data-node] { grid-column: 1; grid-row: auto; }
    .ecosystem-explorer__card[data-node]::after, .ecosystem-explorer__connector { display: none; }
    .ecosystem-explorer__card { border-left: 3px solid var(--teal); }
  }
  @media (prefers-reduced-motion: reduce) { .ecosystem-explorer__card, .ecosystem-explorer__card button > span { transition: none; } .ecosystem-explorer__card.is-selected { transform: none; } }
</style>
