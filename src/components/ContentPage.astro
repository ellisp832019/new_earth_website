---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/site';
const { slug }=Astro.props; const page=pages[slug];
---
<BaseLayout title={page.title} canonical={`/${slug}/`}><article class="content-page"><header class="page-hero shell"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lede">{page.intro}</p></header><div class="shell content-flow">{page.sections.map(([heading,copy])=><section><h2>{heading}</h2>{copy.split('\n\n').map(paragraph=><p>{paragraph}</p>)}</section>)}<nav class="page-actions" aria-label="Continue exploring">{page.links.map(([label,href])=><a class="button" href={href}>{label}</a>)}</nav></div></article></BaseLayout>
